# Copy to `.env` and adjust for your machine.
#
# Android emulator reaches the host machine via 10.0.2.2, not localhost.
# iOS simulator and Expo web can use localhost.

# Default: http://localhost:5001/api
EXPO_PUBLIC_API_URL=http://localhost:5001/api

# Socket.IO server origin (no /api suffix).
EXPO_PUBLIC_SOCKET_URL=http://localhost:5001

# Set to "production" to silence dev-only console hints.
EXPO_PUBLIC_ENV=development
