# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/seat-app

# --- Auth (JWT) ---
# Access tokens are short-lived, refresh tokens long-lived.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# --- Password reset OTP ---
OTP_SECRET=change-me-otp-secret
OTP_EXPIRES_MINUTES=10

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- CORS ---
CORS_ORIGIN=*

# --- Email (nodemailer; falls back to console logging when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SEAT App <no-reply@seat.local>

# --- Push notifications (Expo) ---
# Server sends Expo push messages to user.pushToken values.
EXPO_PUSH_ACCESS_TOKEN=
